# Copy to .env and fill in from Supabase → Project Settings → API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only (scripts, Edge Functions). Never prefix it with VITE_.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Browser-safe values for the app. Vite only exposes VITE_* variables to the bundle.
# On Netlify, set these two directly in Project configuration → Environment variables.
VITE_SUPABASE_URL=$SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=$SUPABASE_PUBLISHABLE_KEY
